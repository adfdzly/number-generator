# Copy to ".env" and fill in. docker compose reads it automatically.

# ----------------------------------------------------------------------------
# PRIVATE ACCESS (secret link)
# ----------------------------------------------------------------------------
# Turns the site private. Share this link with the people you trust:
#     https://your-domain/?key=<ACCESS_TOKEN>
# Opening it sets a cookie so they stay logged in. Leave blank to make the
# site public. Generate a strong value, e.g.:  openssl rand -hex 24
ACCESS_TOKEN=change-me-to-a-long-random-string

# ----------------------------------------------------------------------------
# CLOUDFLARE TUNNEL  (only for: docker compose --profile cloudflare up -d)
# ----------------------------------------------------------------------------
# Cloudflare dashboard > Zero Trust > Networks > Tunnels > (create) > token.
# Point the tunnel's public hostname at the service URL  http://nginx:80
TUNNEL_TOKEN=
